{
  "expo": {
    "name": "ChatApp",
    "slug": "chatapp",
    "version": "1.0.9",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://chat.datslok.no/app-update",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "no.datslok.chat",
      "versionCode": 10,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chat.datslok.no",
              "path": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0086D7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/animated-webp",
      "./plugins/share-intent",
      "./plugins/release-signing",
      "./plugins/dev-variant",
      "expo-sharing",
      "expo-video",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
