# Settings for the AI bot (chattus.py) against the development server, used by .\chattus.ps1 -Dev
# (README, "Working on the bot"). Optional: only needed when working on the bot.
# Copy this file to dev-chattus.env and fill in your own values. dev-chattus.env is never committed
# (it's in .gitignore).

# The bot account's password in dev.db. Don't type one: this fills it in (and makes the account):
#   python tools\make_bot.py --db dev.db --uploads dev-uploads --env dev-chattus.env
CHATTUS_PASSWORD=

# The local model: the server's LLAMA_API_KEY (from its .env), with the model reached through
# `ssh -L 8080:127.0.0.1:8080 chatserver` in another window.
LLAMA_API_KEY=

# Or Claude instead of the local model (then no tunnel is needed): a model like claude-haiku-5-5,
# and a key from platform.claude.com (paid per use). Empty CHATTUS_MODEL: the local model.
CHATTUS_MODEL=
ANTHROPIC_API_KEY=
