# Python's compiled cache files (recreated automatically)
__pycache__/
*.pyc

# Secrets: passwords, API keys, etc. Never commit these.
.env

# The SQLite database (holds everyone's messages and accounts)
*.db
*.sqlite3

# Uploaded images and files (your friends' photos don't belong on GitHub)
uploads/
dev-uploads/

# Backup copies of the database and uploads
backups/

# Editor and OS clutter
.vscode/
Thumbs.db

# Desktop app: npm packages and Rust's build output (both recreated by building)
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Desktop app installers, served at /releases/ for the app's automatic updates
releases/
