# Settings for development, loaded by start.ps1. No secrets here, so this file is committed.
# (The real site uses .env instead, through serve.ps1.)

# Keep test messages and files away from the real chat.
DATABASE_FILE=dev.db
UPLOAD_DIR=dev-uploads

# Links in emails point to the development server. There's no SMTP_HOST here, so emails
# (like password reset links) are printed in the server window instead of being sent.
PUBLIC_URL=http://localhost:8001

# Voice: LiveKit started with ".\voice.ps1 -Dev", which only listens on this PC and uses these
# public test values as its key and secret (so they're no secret, and fine to commit).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
