# Settings for your own ChatApp server, loaded by serve.ps1 (the chat) and voice.ps1 (LiveKit).
# Copy this file to .env and fill in your own values. .env is never committed (it's in .gitignore).
# The addresses below use chat.example.com and voice.example.com: replace them with yours.

# The code people need to create an account. Make it hard to guess, and share it only with
# the people you want in. Without it, anyone who finds the site could make an account.
INVITE_CODE=change-me

# 1 = login cookies are only ever sent over HTTPS. Keep this on for a real site.
SECURE_COOKIES=1

# The site's address. Used for the links in emails (password resets), and as the default
# sender domain below.
PUBLIC_URL=https://chat.example.com

# Email, for "forgot password" links and bug reports to admins. Any mail service with SMTP works
# (Resend, Brevo, Mailgun, your email provider, ...). Leave SMTP_HOST empty to skip email: the
# emails are then printed in the server's log instead, and "forgot password" can't reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Who the emails come from (an address your mail service lets you send as).
# Default: noreply@ the domain in PUBLIC_URL.
MAIL_FROM=ChatApp <noreply@chat.example.com>

# Voice, video and screen sharing go through LiveKit (started by voice.ps1). Its public address,
# which browsers connect to, and a key and secret it shares with the chat server, which signs
# the tickets that let people into a call. The key is just a name; the secret must be long and
# random. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_URL=wss://voice.example.com
LIVEKIT_API_KEY=chatapp
LIVEKIT_API_SECRET=change-me
