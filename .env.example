# Settings for your own ChatApp server, loaded by serve.ps1 (the chat), voice.ps1 (LiveKit) and
# llama.ps1 (the optional AI bot's model).
# Copy this file to .env and fill in your own values. .env is never committed (it's in .gitignore).
# The addresses below use chat.example.com and voice.example.com: replace them with yours.

# (No setting needed for who may join: a new account needs an invite link from someone already in
# the chat, People → Invite someone. Only the very first account, yours, needs none, and it becomes
# the admin by itself.)

# 1 = login cookies are only ever sent over HTTPS. Keep this on for a real site.
SECURE_COOKIES=1

# The site's address. Used for the links in emails (password resets), and as the default
# sender domain below.
PUBLIC_URL=https://chat.example.com

# Optional: your main domain, if it should show a page about ChatApp with buttons to the chat
# (static/landing/). It also needs adding to the tunnel (README, "A landing page"). Empty = none.
# The page is always at /welcome too.
LANDING_HOST=

# Email, for "forgot password" links and bug reports to admins. Any mail service with SMTP works
# (Resend, Brevo, Mailgun, your email provider, ...). Leave SMTP_HOST empty to skip email: the
# emails are then printed in the server's log instead, and "forgot password" can't reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Who the emails come from (an address your mail service lets you send as).
# Default: noreply@ the domain in PUBLIC_URL.
MAIL_FROM=ChatApp <noreply@chat.example.com>

# Voice, video and screen sharing go through LiveKit (started by voice.ps1). Its public address,
# which browsers connect to, and a key and secret it shares with the chat server, which signs
# the tickets that let people into a call. The key is just a name; the secret must be long and
# random. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_URL=wss://voice.example.com
LIVEKIT_API_KEY=chatapp
LIVEKIT_API_SECRET=change-me

# Push notifications on phones (and in browsers) while the chat is closed: a key pair the server
# signs them with, so only it can send your users notifications. Make it once with
#   python tools/make_vapid_keys.py
# and put its two lines here. Keep the private key secret. Empty: no push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push notifications in the native phone app (mobile/) go through Firebase Cloud Messaging instead: the
# server reads your Firebase project's service account key from this file (README, "Push notifications
# in the app"). Never commit it. Not there: the app gets no pushes (the web page's still work).
# FIREBASE_KEY_FILE=firebase-key.json

# Optional: GIF search (the GIF button by the text box), through GIPHY. A free key: make an account at
# developers.giphy.com, then "Create an App" -> API. Empty: no GIF search (the button says so).
GIPHY_API_KEY=

# Optional: the AI bot's account password. Don't type one: tools/make_bot.py makes the account and
# writes this line itself (README "Optional: an AI bot").
CHATTUS_PASSWORD=

# Optional: the AI bot's language model (llama.ps1, README "Optional: an AI bot"). The key that
# programs on the server need to use it. scripts\server\install.ps1 -AI makes it and adds it here.
LLAMA_API_KEY=

# Optional: the AI bot on Claude (Anthropic's API) instead of the local model. With CHATTUS_MODEL set
# (like claude-haiku-5-5), his answers come from Anthropic, so the messages he reads are sent there
# (README "Optional: an AI bot"). The key comes from platform.claude.com, paid per use.
CHATTUS_MODEL=
ANTHROPIC_API_KEY=

# Optional: the AI bot's web search (Exa). It works without a key, but then Exa only allows a few
# searches now and then. A free account at exa.ai gives you a key with your own allowance.
EXA_API_KEY=
