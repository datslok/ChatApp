# Settings for the real site (chat.datslok.no), loaded by serve.ps1.
# Copy this file to .env and fill in your own values. .env is never committed.

# The code friends need to create an account. Make it hard to guess.
INVITE_CODE=change-me

# 1 = session cookies are only ever sent over HTTPS. Keep this on for the real site.
SECURE_COOKIES=1

# The site's address, used for the links in password reset emails.
PUBLIC_URL=https://chat.datslok.no

# The mail server that sends the emails (here: Resend's SMTP server).
# Leave SMTP_HOST empty to print emails in the server window instead of sending them.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
MAIL_FROM=Our Chat <noreply@datslok.no>
